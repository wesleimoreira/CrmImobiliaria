# Copie este arquivo para ".env" (ou configure como variáveis de ambiente no painel do Dokploy)
# e preencha com valores reais. NUNCA commite o ".env" de verdade — ele já está no .gitignore.

# Senha do usuário "sa" do SQL Server. Use uma senha forte (mínimo 8 caracteres, com
# maiúscula, minúscula, número e símbolo — é exigência do próprio SQL Server).
MSSQL_SA_PASSWORD=TrocarPorUmaSenhaForte#2026

# Credenciais do usuário administrador criado automaticamente na primeira execução.
SEED_ADMIN_EMAIL=admin@primefrota.cloud
SEED_ADMIN_PASSWORD=TrocarPorOutraSenhaForte#2026
