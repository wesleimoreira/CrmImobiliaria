@page "/visitas"
@inject IQueryHandler<ListarVisitasQuery, List<VisitaListaItemDto>> ListarHandler

<PageTitle>Visitas</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Visitas</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="termo" Label="Buscar por cliente" Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                         DebounceInterval="300" OnDebounceIntervalElapsed="OnTermoAlterado" />
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/visitas/nova">
                Agendar Visita
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@visitas" Hover="true" Loading="@(visitas is null)" Elevation="0" Outlined="true">
    <HeaderContent>
        <MudTh>Cliente</MudTh>
        <MudTh>Imóvel</MudTh>
        <MudTh>Corretor</MudTh>
        <MudTh>Data/Hora</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
        <MudTd DataLabel="Imóvel">@context.ImovelEndereco</MudTd>
        <MudTd DataLabel="Corretor">@context.CorretorNome</MudTd>
        <MudTd DataLabel="Data/Hora">@context.DataHora.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CorPorStatus(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/visitas/{context.Id}")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Nenhuma visita agendada.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<VisitaListaItemDto>? visitas;
    private string? termo;

    protected override async Task OnInitializedAsync() => await Buscar();

    private async Task OnTermoAlterado(string valor) => await Buscar();

    private async Task Buscar()
    {
        var resultado = await ListarHandler.HandleAsync(new ListarVisitasQuery(termo));
        visitas = resultado.Value;
    }

    private static Color CorPorStatus(StatusVisita status) => status switch
    {
        StatusVisita.Realizada => Color.Success,
        StatusVisita.Confirmada => Color.Info,
        StatusVisita.Cancelada or StatusVisita.NaoCompareceu => Color.Error,
        _ => Color.Default
    };
}
