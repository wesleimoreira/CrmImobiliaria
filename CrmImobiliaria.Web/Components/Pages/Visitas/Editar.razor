@page "/visitas/{Id:guid}"
@inject IQueryHandler<ObterVisitaPorIdQuery, VisitaDetalheDto?> ObterHandler
@inject ICommandHandler<AlterarStatusVisitaCommand, bool> AlterarStatusHandler
@inject ICommandHandler<ReagendarVisitaCommand, bool> ReagendarHandler

<PageTitle>Visita</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Visita</MudText>

@if (erro is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@erro</MudAlert>
}

@if (visita is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption">Cliente</MudText>
                <MudText Typo="Typo.body1">@visita.ClienteNome</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption">Imóvel</MudText>
                <MudText Typo="Typo.body1">@visita.ImovelEndereco</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption">Corretor</MudText>
                <MudText Typo="Typo.body1">@visita.CorretorNome</MudText>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.caption">Status</MudText>
                <div><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@visita.Status</MudChip></div>
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(visita.Feedback))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Feedback</MudText>
                    <MudText Typo="Typo.body1">@visita.Feedback</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    @if (visita.Status is StatusVisita.Agendada or StatusVisita.Confirmada)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Ações</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-3">
                @if (visita.Status == StatusVisita.Agendada)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Confirmar">Confirmar</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="RegistrarRealizada">Marcar como realizada</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="MarcarNaoCompareceu">Não compareceu</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="Cancelar">Cancelar</MudButton>
            </MudStack>

            <MudTextField T="string" @bind-Value="texto" Label="Feedback / motivo (opcional, usado nas ações acima)" Class="mb-3" />

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="DateTime" @bind-Value="novaDataHora" Label="Nova data e hora" InputType="InputType.DateTimeLocal" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Reagendar">Reagendar</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudButton Variant="Variant.Text" Href="/visitas">Voltar</MudButton>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private VisitaDetalheDto? visita;
    private string? erro;
    private string? texto;
    private DateTime novaDataHora = DateTime.Now.AddDays(1);

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        var resultado = await ObterHandler.HandleAsync(new ObterVisitaPorIdQuery(Id));
        visita = resultado.Value;
    }

    private async Task ExecutarAcao(AcaoVisita acao)
    {
        var resultado = await AlterarStatusHandler.HandleAsync(new AlterarStatusVisitaCommand(Id, acao, texto));
        if (!resultado.IsSuccess) { erro = resultado.Error; return; }
        erro = null;
        texto = null;
        await Carregar();
    }

    private Task Confirmar() => ExecutarAcao(AcaoVisita.Confirmar);
    private Task RegistrarRealizada() => ExecutarAcao(AcaoVisita.RegistrarRealizada);
    private Task MarcarNaoCompareceu() => ExecutarAcao(AcaoVisita.MarcarNaoCompareceu);
    private Task Cancelar() => ExecutarAcao(AcaoVisita.Cancelar);

    private async Task Reagendar()
    {
        var resultado = await ReagendarHandler.HandleAsync(new ReagendarVisitaCommand(Id, novaDataHora));
        if (!resultado.IsSuccess) { erro = resultado.Error; return; }
        erro = null;
        await Carregar();
    }
}
