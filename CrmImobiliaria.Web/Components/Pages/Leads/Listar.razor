@page "/leads"
@inject IQueryHandler<ListarLeadsQuery, List<LeadListaItemDto>> ListarHandler

<PageTitle>Funil de Atendimento</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Funil de Atendimento</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="termo" Label="Buscar por cliente" Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                         DebounceInterval="300" OnDebounceIntervalElapsed="OnTermoAlterado" />
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/leads/novo">
                Novo Lead
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@leads" Hover="true" Loading="@(leads is null)" Elevation="0" Outlined="true">
    <HeaderContent>
        <MudTh>Cliente</MudTh>
        <MudTh>Corretor</MudTh>
        <MudTh>Estágio</MudTh>
        <MudTh>Criado em</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
        <MudTd DataLabel="Corretor">@context.CorretorNome</MudTd>
        <MudTd DataLabel="Estágio">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(context.EstagioAtual == EstagioFunil.Perdido ? Color.Error : context.EstagioAtual == EstagioFunil.Fechado ? Color.Success : Color.Info)">
                @context.EstagioAtual
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Criado em">@context.CriadoEm.ToLocalTime().ToString("g")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/leads/{context.Id}")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Nenhum lead cadastrado.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<LeadListaItemDto>? leads;
    private string? termo;

    protected override async Task OnInitializedAsync() => await Buscar();

    private async Task OnTermoAlterado(string valor) => await Buscar();

    private async Task Buscar()
    {
        var resultado = await ListarHandler.HandleAsync(new ListarLeadsQuery(termo));
        leads = resultado.Value;
    }
}
