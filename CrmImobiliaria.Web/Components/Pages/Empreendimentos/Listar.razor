@page "/empreendimentos"
@inject IQueryHandler<ListarEmpreendimentosQuery, List<EmpreendimentoListaItemDto>> ListarHandler

<PageTitle>Empreendimentos</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Empreendimentos</MudText>

<div class="d-flex justify-end mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/empreendimentos/novo">
        Novo Empreendimento
    </MudButton>
</div>

<MudTable Items="@empreendimentos" Hover="true" Loading="@(empreendimentos is null)" Elevation="0" Outlined="true">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Loteadora/Incorporadora</MudTh>
        <MudTh>Localização</MudTh>
        <MudTh>Lotes</MudTh>
        <MudTh>Quadras</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nome">@context.Nome</MudTd>
        <MudTd DataLabel="Loteadora/Incorporadora">@context.LoteadoraIncorporadora</MudTd>
        <MudTd DataLabel="Localização">@context.Localizacao</MudTd>
        <MudTd DataLabel="Lotes">@context.TotalLotes</MudTd>
        <MudTd DataLabel="Quadras">@context.NumeroQuadras</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CorPorStatus(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"/empreendimentos/{context.Id}")" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Nenhum empreendimento cadastrado.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<EmpreendimentoListaItemDto>? empreendimentos;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ListarHandler.HandleAsync(new ListarEmpreendimentosQuery());
        empreendimentos = resultado.Value;
    }

    private static Color CorPorStatus(StatusEmpreendimento status) => status switch
    {
        StatusEmpreendimento.EmComercializacao => Color.Success,
        StatusEmpreendimento.Suspenso or StatusEmpreendimento.Encerrado => Color.Error,
        StatusEmpreendimento.Lancado => Color.Info,
        _ => Color.Default
    };
}
