@page "/propostas/nova"
@inject ICommandHandler<CriarPropostaCommand, Guid> CriarHandler
@inject IQueryHandler<ListarClientesQuery, List<ClienteListaItemDto>> ListarClientesHandler
@inject IQueryHandler<ListarImoveisQuery, List<ImovelListaItemDto>> ListarImoveisHandler
@inject IQueryHandler<ObterImovelPorIdQuery, ImovelDetalheDto?> ObterImovelHandler
@inject IQueryHandler<ListarCorretoresQuery, List<CorretorResumoDto>> ListarCorretoresHandler
@inject NavigationManager Navigation

<PageTitle>Nova Proposta</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Nova Proposta</MudText>

@if (erro is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@erro</MudAlert>
}

@if (clientes is null || imoveis is null || corretores is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="clienteId" Label="Cliente" Required="true">
                    @foreach (var cliente in clientes)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)cliente.Id)">@cliente.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="corretorId" Label="Corretor" Required="true">
                    @foreach (var corretor in corretores)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)corretor.Id)">@corretor.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="imovelId" Label="Imóvel" Required="true" @bind-Value:after="OnImovelAlterado">
                    @foreach (var imovel in imoveis)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)imovel.Id)">@imovel.Endereco</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="Guid?" @bind-Value="anuncioId" Label="Anúncio" Required="true" Disabled="@(anuncios is null || anuncios.Count == 0)">
                    @if (anuncios is not null)
                    {
                        @foreach (var anuncio in anuncios)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)anuncio.Id)">@anuncio.Codigo — @anuncio.Valor.ToString("C")</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" @bind-Value="valorProposto" Label="Valor proposto" Format="N2" Adornment="Adornment.Start" AdornmentText="R$" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="FormaPagamento" @bind-Value="formaPagamento" Label="Forma de pagamento" Required="true">
                    @foreach (var forma in Enum.GetValues<FormaPagamento>())
                    {
                        <MudSelectItem T="FormaPagamento" Value="@forma">@forma</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (formaPagamento != FormaPagamento.AVista)
            {
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal?" @bind-Value="entrada" Label="Entrada" Format="N2" Adornment="Adornment.Start" AdornmentText="R$" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int?" @bind-Value="numeroParcelas" Label="Número de parcelas" Min="1" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal?" @bind-Value="valorParcela" Label="Valor da parcela" Format="N2" Adornment="Adornment.Start" AdornmentText="R$" />
                </MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Class="mt-4" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Salvar">Salvar</MudButton>
            <MudButton Variant="Variant.Text" Href="/propostas">Cancelar</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private List<ClienteListaItemDto>? clientes;
    private List<ImovelListaItemDto>? imoveis;
    private List<CorretorResumoDto>? corretores;
    private List<AnuncioResumoDto>? anuncios;
    private string? erro;

    private Guid? clienteId;
    private Guid? imovelId;
    private Guid? anuncioId;
    private Guid? corretorId;
    private decimal valorProposto;
    private FormaPagamento formaPagamento = FormaPagamento.AVista;
    private decimal? entrada;
    private int? numeroParcelas;
    private decimal? valorParcela;

    protected override async Task OnInitializedAsync()
    {
        clientes = (await ListarClientesHandler.HandleAsync(new ListarClientesQuery(null))).Value;
        imoveis = (await ListarImoveisHandler.HandleAsync(new ListarImoveisQuery(null))).Value;
        corretores = (await ListarCorretoresHandler.HandleAsync(new ListarCorretoresQuery())).Value;
    }

    private async Task OnImovelAlterado()
    {
        anuncioId = null;
        anuncios = null;

        if (imovelId is { } id)
        {
            var resultado = await ObterImovelHandler.HandleAsync(new ObterImovelPorIdQuery(id));
            anuncios = resultado.Value?.Anuncios;
        }
    }

    private async Task Salvar()
    {
        var comando = new CriarPropostaCommand(
            clienteId ?? Guid.Empty, imovelId ?? Guid.Empty, anuncioId ?? Guid.Empty, corretorId ?? Guid.Empty,
            valorProposto, entrada, numeroParcelas, valorParcela, formaPagamento);

        var resultado = await CriarHandler.HandleAsync(comando);

        if (!resultado.IsSuccess)
        {
            erro = resultado.Error;
            return;
        }

        Navigation.NavigateTo("/propostas");
    }
}
